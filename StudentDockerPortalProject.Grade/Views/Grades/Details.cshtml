@model GradeDetailViewModel
@{
    ViewData["Title"] = "Grade Details";
}

<a asp-action="Index" class="btn-back mb-4">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
        <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
    </svg>
    Back to Grades
</a>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-4" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" class="flex-shrink-0">
            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
        </svg>
        <div>@Model.ErrorMessage</div>
    </div>
}

<div class="card-clean p-4 p-md-5">
    <div class="d-flex align-items-center gap-3 mb-4">
        <span class="avatar-lg">
            @(Model.StudentName?.Split(' ') is { Length: > 0 } parts
                ? $"{parts[0][0]}{(parts.Length > 1 ? parts[^1][0].ToString() : "")}"
                : "GR")
        </span>
        <div>
            <h2 class="h3 fw-bold mb-0">@Model.CourseName</h2>
            <div class="d-flex align-items-center gap-2 mt-1">
                <span class="badge-custom">Grade ID: @Model.Id</span>
                <span class="text-muted small">Student ID: @Model.StudentId</span>
            </div>
        </div>
    </div>

    <hr class="my-4 opacity-25" />

    <div class="row g-3">
        <div class="col-md-6">
            <div class="detail-card">
                <span class="detail-label">Student</span>
                <p class="detail-value">@(Model.StudentName ?? "—")</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="detail-card">
                <span class="detail-label">Course</span>
                <p class="detail-value">@Model.CourseName</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="detail-card">
                <span class="detail-label">Score</span>
                <p class="detail-value @(Model.Score >= 60 ? "" : "text-danger")">@Model.Score.ToString("N1")</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="detail-card">
                <span class="detail-label">Grade Date</span>
                <p class="detail-value">@Model.GradeDate.ToString("MMMM dd, yyyy")</p>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="col-12">
                <div class="detail-card">
                    <span class="detail-label">Notes</span>
                    <p class="detail-value">@Model.Notes</p>
                </div>
            </div>
        }
    </div>

    <hr class="my-4 opacity-25" />

    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
            </svg>
            Edit Grade
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger rounded-pill px-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
            </svg>
            Delete Grade
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Back to List</a>
    </div>
</div>
