@inject Microsoft.AspNetCore.Mvc.Routing.IUrlHelperFactory UrlHelperFactory
@{
    var urlHelper = UrlHelperFactory.GetUrlHelper(ViewContext);
    string? ActivePage(string? controller, string? action = null)
    {
        var current = ViewContext.RouteData.Values["controller"]?.ToString();
        var act = ViewContext.RouteData.Values["action"]?.ToString();
        if (controller == current && (action == null || action == act)) return "active";
        return null;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Student Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StudentDockerPortalProject.Students.styles.css" asp-append-version="true" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark navbar-main" id="mainNav">
