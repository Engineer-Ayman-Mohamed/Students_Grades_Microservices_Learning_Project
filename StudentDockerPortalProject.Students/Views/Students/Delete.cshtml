@model Student
@{
    ViewData["Title"] = "Delete Student";
}

<a asp-action="Index" class="btn-back mb-4">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
        <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
    </svg>
    Back to Students
</a>

<div class="danger-card">
    <div class="mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="var(--danger)" viewBox="0 0 16 16">
            <path d="M11 1.5v1h3.5a.5.5 0 0 1 0 1h-.538l-.853 10.66A2 2 0 0 1 11.115 16h-6.23a2 2 0 0 1-1.994-1.84L2.038 3.5H1.5a.5.5 0 0 1 0-1H5v-1A1.5 1.5 0 0 1 6.5 0h3A1.5 1.5 0 0 1 11 1.5m-5 0v1h4v-1a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5M4.552 7.146 7.5 9.5l2.948-2.354a.5.5 0 1 1 .604.796L8.146 10.25a.5.5 0 0 1-.292 0l-2.906-2.308a.5.5 0 1 1 .604-.796M4.5 7.5a.5.5 0 0 0-.5.5v5a.5.5 0 0 0 1 0V8a.5.5 0 0 0-.5-.5m7 0a.5.5 0 0 0-.5.5v5a.5.5 0 0 0 1 0V8a.5.5 0 0 0-.5-.5"/>
        </svg>
    </div>

    <h4 class="fw-bold mb-2">Delete Student</h4>
    <p class="mb-1">Are you sure you want to delete <strong class="text-danger">@Model.FirstName @Model.LastName</strong>?</p>
    <p class="text-muted small mb-4">This action cannot be undone.</p>

    <div class="bg-light rounded-3 p-3 mb-4 mx-auto text-start" style="max-width: 380px; background: var(--danger-50) !important;">
        <div class="row g-2 small">
            <div class="col-5 text-muted">Name:</div>
            <div class="col-7 fw-medium">@Model.FirstName @Model.LastName</div>
            <div class="col-5 text-muted">Email:</div>
            <div class="col-7 fw-medium">@Model.Email</div>
            <div class="col-5 text-muted">DOB:</div>
            <div class="col-7">@Model.DateOfBirth.ToString("MMM dd, yyyy")</div>
            <div class="col-5 text-muted">Enrolled:</div>
            <div class="col-7">@Model.EnrollmentDate.ToString("MMM dd, yyyy")</div>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="d-inline">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger rounded-pill px-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
            </svg>
            Confirm Delete
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 ms-2">Cancel</a>
    </form>
</div>
