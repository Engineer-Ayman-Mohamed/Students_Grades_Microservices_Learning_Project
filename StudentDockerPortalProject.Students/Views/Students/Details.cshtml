@model Student
@{
    ViewData["Title"] = "Student Details";
}

<a asp-action="Index" class="btn-back mb-4">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
        <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
    </svg>
    Back to Students
</a>

<div class="card-clean p-4 p-md-5">
    <div class="d-flex align-items-center gap-3 mb-4">
        <span class="avatar-lg">@Model.FirstName[0]@Model.LastName[0]</span>
        <div>
            <h2 class="h3 fw-bold mb-0">@Model.FirstName @Model.LastName</h2>
            <div class="d-flex align-items-center gap-2 mt-1">
                <span class="badge-custom">ID: @Model.Id</span>
                <span class="text-muted small">Enrolled @Model.EnrollmentDate.ToString("MMM yyyy")</span>
            </div>
        </div>
    </div>

    <hr class="my-4 opacity-25" />

    <div class="row g-3">
        <div class="col-md-6">
            <div class="detail-card">
                <span class="detail-label">First Name</span>
                <p class="detail-value">@Model.FirstName</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="detail-card">
                <span class="detail-label">Last Name</span>
                <p class="detail-value">@Model.LastName</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="detail-card">
                <span class="detail-label">Email Address</span>
                <p class="detail-value">@Model.Email</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="detail-card">
                <span class="detail-label">Date of Birth</span>
                <p class="detail-value">@Model.DateOfBirth.ToString("MMMM dd, yyyy")</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="detail-card">
                <span class="detail-label">Enrollment Date</span>
                <p class="detail-value">@Model.EnrollmentDate.ToString("MMMM dd, yyyy")</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="detail-card" style="border-left-color: var(--gray-400);">
                <span class="detail-label">Age</span>
                <p class="detail-value">
                    @{
                        var age = DateTime.Today.Year - Model.DateOfBirth.Year;
                        if (Model.DateOfBirth.Date > DateTime.Today.AddYears(-age)) age--;
                    }
                    @age years
                </p>
            </div>
        </div>
    </div>

    <hr class="my-4 opacity-25" />

    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
            </svg>
            Edit Student
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Back to List</a>
    </div>
</div>
