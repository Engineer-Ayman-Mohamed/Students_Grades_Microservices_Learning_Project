@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="page-head">
    <h1>Privacy Policy</h1>
    <p>How we handle your data</p>
</div>

<div class="card-clean p-4 p-md-5">
    <h5 class="fw-bold mb-3">Information We Collect</h5>
    <p class="text-muted mb-4">We collect personal information that you voluntarily provide to us when registering as a student, including your name, email address, and date of birth. This information is used solely for academic record-keeping and administrative purposes.</p>

    <h5 class="fw-bold mb-3">How We Use Your Information</h5>
    <p class="text-muted mb-4">The information collected is used to maintain student records, manage enrollments, and facilitate communication regarding academic activities. We do not share your personal data with third parties unless required by law.</p>

    <h5 class="fw-bold mb-3">Data Security</h5>
    <p class="text-muted mb-4">We implement appropriate security measures to protect your personal information from unauthorized access, alteration, disclosure, or destruction.</p>

    <h5 class="fw-bold mb-3">Contact</h5>
    <p class="text-muted">If you have any questions about this privacy policy, please contact the administration office.</p>
</div>
