@{
    ViewData["Title"] = "Home";
}

<div class="page-head">
    <h1>Welcome to Student Portal</h1>
    <p>Manage students and academic records</p>
</div>

<div class="row g-4">
    <div class="col-md-6 col-lg-4">
        <div class="card-clean p-4 h-100">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="stat-icon blue">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1zm-7.978-1L7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002-.014.002zM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4m3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0M6.936 9.28a6 6 0 0 0-1.23-.247A7 7 0 0 0 5 9c-4 0-5 3-5 4q0 1 1 1h4.216A2.24 2.24 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904.243-.294.526-.569.846-.816M4.92 10A5.5 5.5 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275ZM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0m3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4"/>
                    </svg>
                </div>
                <div>
                    <div class="stat-number">Students</div>
                    <div class="stat-label">Manage student records</div>
                </div>
            </div>
            <a asp-controller="Students" asp-action="Index" class="btn btn-outline-primary w-100">
                View Students &rarr;
            </a>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card-clean p-4 h-100">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="stat-icon green">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M12.5 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7m.5-5v1h1a.5.5 0 0 1 0 1h-1v1a.5.5 0 0 1-1 0v-1h-1a.5.5 0 0 1 0-1h1v-1a.5.5 0 0 1 1 0m-2-6a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0M5.494 9.473c-2.146.344-3.7 1.56-4.312 3.155C.558 13.427.002 14.646.002 16h5.548A5.5 5.5 0 0 1 5.5 14.5c0-.898.226-1.744.628-2.48a2.8 2.8 0 0 0-.634-.547"/>
                    </svg>
                </div>
                <div>
                    <div class="stat-number">Quick Entry</div>
                    <div class="stat-label">Add a new student</div>
                </div>
            </div>
            <a asp-controller="Students" asp-action="Create" class="btn btn-primary w-100">
                Add Student &rarr;
            </a>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card-clean p-4 h-100">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="stat-icon pink">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M5.338 1.59a61 61 0 0 0-2.837.856.48.48 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.7 10.7 0 0 0 2.287 2.233c.346.244.652.42.893.533q.18.085.293.118a1 1 0 0 0 .101.025 1 1 0 0 0 .1-.025q.114-.033.294-.118c.24-.113.547-.29.893-.533a10.7 10.7 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.8 11.8 0 0 1-2.517 2.453 7 7 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7 7 0 0 1-1.048-.625 11.8 11.8 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 63 63 0 0 1 5.072.56"/>
                        <path d="M9.5 6.5a1.5 1.5 0 0 1-3 0 1.5 1.5 0 0 1 3 0m-5 0a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0m.5 4.16q.91.352 2 .352c1.09 0 1.91-.148 2-.352-.3.832-1.242 1.352-2 1.352s-1.7-.52-2-1.352"/>
                    </svg>
                </div>
                <div>
                    <div class="stat-number">Privacy</div>
                    <div class="stat-label">View privacy policy</div>
                </div>
            </div>
            <a asp-controller="Home" asp-action="Privacy" class="btn btn-outline-secondary w-100">
                View Policy &rarr;
            </a>
        </div>
    </div>
</div>

@if (ViewBag.TotalStudents != null)
{
    <div class="mt-4">
        <div class="card-clean p-4 text-center">
            <div class="stat-number" style="color: var(--primary);">@ViewBag.TotalStudents</div>
            <div class="stat-label">total students enrolled</div>
        </div>
    </div>
}
